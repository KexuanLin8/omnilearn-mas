    "@vitejs/plugin-react": "^4.3.4",
    "cors": "^2.8.6",
    "express": "^4.22.2",
    "katex": "^0.17.0",
    "mermaid": "^11.16.0",
    "multer": "^2.2.0",
    "pdf-parse": "^1.1.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.3",
    "vite": "^6.0.5",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5"
  }
