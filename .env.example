# Server settings
NODE_ENV=production
HOST=127.0.0.1
PORT=8789
DATA_ROOT=./runtime-data
PLATFORM_LIBRARY_ROOT=./platform-library

# Optional server-side model credentials. All three are required for online generation.
SPARK_APP_ID=
SPARK_API_KEY=
SPARK_API_SECRET=

# Optional. Set this before registering the local administrator account.
ADMIN_EMAIL=

# Optional tools for PDF export. Fill in an executable path if needed.
XELATEX_PATH=
MMDC_PATH=
CHROMIUM_PATH=
